{
  "manifest_version": 3,
  "name": "Squarespace MCP Bridge",
  "version": "0.1.0",
  "description": "Lets the Squarespace MCP server on this computer edit your Squarespace sites using your existing login.",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["cookies", "alarms", "storage"],
  "host_permissions": ["https://*.squarespace.com/*", "http://127.0.0.1/*"],
  "action": { "default_title": "Squarespace MCP Bridge", "default_popup": "popup.html" }
}
